# Copy to .env.local. Everything here is free; nothing needs a paid account.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000   # backend, as seen by the browser
API_URL=http://127.0.0.1:8000               # backend, as seen by this server (agent desk)
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=                            # python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_JWT_SECRET=                           # same value as the backend's CS_AGENT_JWT_SECRET
AGENT_EMAILS=agent@example.com              # who may use the agent desk (comma-separated)
# Sign-in: GitHub OAuth (free OAuth app at github.com/settings/developers) and/or a team password.
GITHUB_ID=
GITHUB_SECRET=
AGENT_DEV_PASSWORD=                         # for local use and demos; leave empty to disable
