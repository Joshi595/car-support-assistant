# Copy to .env and adjust. Every setting has a working local default; nothing here needs a paid account.
CS_ENVIRONMENT=dev
CS_LOG_LEVEL=INFO
CS_DATABASE_URL=postgresql+psycopg://car_support:car_support@127.0.0.1:5432/car_support
CS_OLLAMA_URL=http://127.0.0.1:11434
CS_CHAT_MODEL=ollama:gemma3:4b
CS_EMBED_MODEL=qwen3-embedding:4b

# Optional free services (no card needed). Leave empty to run fully local.
# CS_CHAT_MODEL=groq:openai/gpt-oss-120b      # a larger free cloud model (Groq free tier: 200k tokens/day per model)
# CS_FALLBACK_CHAT_MODEL=groq:openai/gpt-oss-20b,ollama:gemma3:4b   # tried in order when the model above fails
CS_GROQ_API_KEY=
# CS_PROMPT_GUARD_MODEL=groq:meta-llama/llama-prompt-guard-2-86m   # extra injection classifier (sends messages to Groq)
CS_OPEN_CHARGE_MAP_KEY=

# Agent sign-in: shared with the frontend (Auth.js). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CS_AGENT_JWT_SECRET=
